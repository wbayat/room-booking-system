<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="170.0" maxWidth="1.7976931348623157E308" prefWidth="630.0" style="-fx-background-color: #D2D2D2; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group13.roombookingsystem.controller.user.BookingCardController">
    <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <Label text="Booking Details">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
         <HBox spacing="6.0">
            <children>
                  <Label fx:id="RoomName" text="Room A">
                      <font>
                          <Font size="18.0" />
                      </font>
                  </Label>
               <Label layoutX="10.0" layoutY="10.0" text="-">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
               <Label fx:id="RoomLocation" layoutX="10.0" layoutY="10.0" text="BRG">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Label>
            </children>
         </HBox>
            <Label fx:id="checkinDate" layoutX="25.0" layoutY="55.0" text="November 20, 2025">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
            <HBox spacing="30.0">
                <children>
                    <VBox alignment="CENTER" spacing="3.0">
                        <children>
                            <Label text="Check-in">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>
                            <Label fx:id="checkinTime" layoutX="10.0" layoutY="10.0" text="3:00 PM">
                                <font>
                                    <Font size="14.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>
                    <VBox alignment="CENTER" layoutX="10.0" layoutY="10.0" spacing="3.0">
                        <children>
                            <Label text="Check-out">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>
                            <Label fx:id="checkoutTime" layoutX="10.0" layoutY="10.0" text="8:00 PM">
                                <font>
                                    <Font size="14.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>
                </children>
            </HBox>
        </children>
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>
    </VBox>
    <VBox alignment="CENTER" layoutX="406.0" prefWidth="210.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="0.0">
        <children>
            <Button fx:id="modifyButton" maxWidth="1.7976931348623157E308" minHeight="45.0" mnemonicParsing="false" onAction="#handleModifyBooking" styleClass="secondary-button" text="Modify">
                <font>
                    <Font size="18.0" />
                </font>
            </Button>
            <Button fx:id="cancelButton" layoutX="10.0" layoutY="10.0" maxWidth="1.7976931348623157E308" minHeight="45.0" mnemonicParsing="false" onAction="#handleCancelBooking" styleClass="primary-button" text="Cancel">
                <font>
                    <Font size="18.0" />
                </font>
            </Button>
        </children>
        <padding>
            <Insets left="10.0" right="10.0" />
        </padding>
    </VBox>
</AnchorPane>
