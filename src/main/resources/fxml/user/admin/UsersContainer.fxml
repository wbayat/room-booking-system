<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="650.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group13.roombookingsystem.controller.user.admin.UsersContainerController">
    <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefHeight="50.0" prefWidth="650.0">
        <padding>
            <Insets left="20.0" right="20.0" />
        </padding>
        <Label text="Users">
            <font>
                <Font size="30.0" />
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="unverifiedTab" maxHeight="35.0" minWidth="100.0" text="Unverified" />
            <Button fx:id="verifiedTab" maxHeight="35.0" minWidth="100.0" text="Verified" />
        </HBox>
    </HBox>
    <ScrollPane fitToWidth="true" layoutX="6.0" layoutY="50.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0">
      <content>
         <VBox fx:id="usersContainer" spacing="10.0">
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
         </VBox>
      </content>
    </ScrollPane>
</AnchorPane>
